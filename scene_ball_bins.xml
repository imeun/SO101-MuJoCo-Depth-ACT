<mujoco model="so101_cube_bins">
  <include file="so101_new_calib.xml" />

  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"
          cone="elliptic" iterations="100" ls_iterations="20">
    <flag multiccd="enable" />
  </option>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.35 0.35 0.35" specular="0.1 0.1 0.1" />
    <global azimuth="145" elevation="-25" />
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.72 0.82 0.94" rgb2="0.04 0.06 0.08" width="512" height="3072" />
    <texture type="2d" name="table_checker" builtin="checker" rgb1="0.78 0.78 0.72" rgb2="0.64 0.66 0.62" width="256" height="256" />
    <material name="floor_mat" rgba="0.18 0.20 0.22 1" />
    <material name="table_mat" texture="table_checker" texuniform="true" texrepeat="3 2" />
    <material name="cube_mat" rgba="0.95 0.2 0.12 1" />
    <material name="square_bin_mat" rgba="0.12 0.35 0.95 1" />
    <material name="workspace_wall_mat" rgba="0.92 0.92 0.90 1" />
    <material name="camera_body_mat" rgba="0.08 0.09 0.10 1" />
  </asset>

  <worldbody>
    <light name="key_light" pos="0 -0.7 1.4" dir="0.1 0.4 -1" directional="true" />
    <geom name="floor" type="plane" size="1.2 1.2 0.05" pos="0 0 -0.0534" material="floor_mat" />

    <geom name="table" type="box" pos="0.22 0 -0.0274" size="0.34 0.26 0.025" material="table_mat" friction="1.0 0.02 0.001" />

    <!-- Inner wall face is 220 mm to the robot's right (negative Y). -->
    <geom name="right_workspace_wall" type="box"
          pos="0.2415173 -0.2250 0.2001" size="0.2725 0.0050 0.2025"
          material="workspace_wall_mat" friction="0.8 0.01 0.001" />

    <body name="cube" pos="0.320 0.155 0.0336">
      <freejoint name="cube_free" />
      <geom name="cube_geom" type="box" size="0.0175 0.0175 0.035" mass="0.025" material="cube_mat" friction="1.2 0.02 0.001" />
    </body>

    <body name="square_bin" pos="0.310 -0.050 -0.0024">
      <geom name="square_bin_floor" type="box" pos="0 0 0.001" size="0.035 0.035 0.001" material="square_bin_mat" />
      <geom name="square_bin_wall_front" type="box" pos="0 0.036 0.0375" size="0.037 0.001 0.0375" material="square_bin_mat" />
      <geom name="square_bin_wall_back" type="box" pos="0 -0.036 0.0375" size="0.037 0.001 0.0375" material="square_bin_mat" />
      <geom name="square_bin_wall_left" type="box" pos="-0.036 0 0.0375" size="0.001 0.037 0.0375" material="square_bin_mat" />
      <geom name="square_bin_wall_right" type="box" pos="0.036 0 0.0375" size="0.001 0.037 0.0375" material="square_bin_mat" />
      <site name="square_bin_goal" pos="0 0 0.035" size="0.008" rgba="0 0 1 0" />
    </body>

    <!-- D435 optical center: 280 mm forward, centered laterally, 620 mm above the table.
         The housing long axis follows world +x in plan view. -->
    <body name="top_depth_camera_mount" pos="0.280 0.000 0.6176"
          quat="1 0 0 0">
      <geom name="top_depth_camera_body" type="box" pos="0 0 0.0125"
            size="0.045 0.0125 0.0125" material="camera_body_mat"
            contype="0" conaffinity="0" />
      <!-- Measured D435 VGA intrinsics. principalpixel is an offset from image
           center in MuJoCo camera coordinates (+x right, +y up). -->
      <camera name="top" pos="0 0 0"
              resolution="640 480" sensorsize="640 480"
              focalpixel="382.2572326660156 382.2572326660156"
              principalpixel="1.12847900390625 1.9199676513671875" />
    </body>
    <!-- D435 optical center: 305 mm forward from the base rear face,
         430 mm left of the robot, and 155 mm above the table. -->
    <body name="side_depth_camera_mount" pos="0.2740173 0.4300 0.1526"
          xyaxes="-0.998179401 -0.060314874 0 0 0 1">
      <geom name="side_depth_camera_body" type="box" pos="0 0 0.0125"
            size="0.045 0.0125 0.0125" material="camera_body_mat"
            contype="0" conaffinity="0" />
      <camera name="side_depth" pos="0 0 0"
              resolution="640 480" sensorsize="640 480"
              focalpixel="384.8880310058594 384.8880310058594"
              principalpixel="7.94189453125 1.1730499267578125" />
    </body>
    <camera name="side" pos="0.05 -0.55 0.32" xyaxes="1 0 0 0 0.45 0.89" />
    <camera name="front" pos="0.60 0 0.30" xyaxes="0 1 0 -0.45 0 0.89" />
  </worldbody>

  <contact>
    <pair name="cube_bin_floor_contact" geom1="cube_geom" geom2="square_bin_floor"
          condim="4" friction="1.2 1.2 0.01 0.001 0.001"
          solref="0.005 1" solimp="0.99 0.999 0.0001" margin="0.0005" />
    <pair name="cube_bin_front_contact" geom1="cube_geom" geom2="square_bin_wall_front"
          condim="4" friction="1.2 1.2 0.01 0.001 0.001"
          solref="0.005 1" solimp="0.99 0.999 0.0001" margin="0.0005" />
    <pair name="cube_bin_back_contact" geom1="cube_geom" geom2="square_bin_wall_back"
          condim="4" friction="1.2 1.2 0.01 0.001 0.001"
          solref="0.005 1" solimp="0.99 0.999 0.0001" margin="0.0005" />
    <pair name="cube_bin_left_contact" geom1="cube_geom" geom2="square_bin_wall_left"
          condim="4" friction="1.2 1.2 0.01 0.001 0.001"
          solref="0.005 1" solimp="0.99 0.999 0.0001" margin="0.0005" />
    <pair name="cube_bin_right_contact" geom1="cube_geom" geom2="square_bin_wall_right"
          condim="4" friction="1.2 1.2 0.01 0.001 0.001"
          solref="0.005 1" solimp="0.99 0.999 0.0001" margin="0.0005" />
  </contact>
</mujoco>
